# =============================================================================
#  Antigravity in Cloud Run — configuration template
# =============================================================================
#
#  Copy this file to `.env` and fill in the values:
#
#      cp .env.template .env
#
#  `.env` is listed in .gitignore and must never be committed. This template
#  is committed, so do not put real secrets in it.
#
#  All three scripts (`deploy-instance.sh`, `deploy.sh`, `run-local.sh`) load
#  `.env` automatically if it exists. Any value already exported in your shell
#  wins over the file, and an explicit command-line argument wins over both.
#
# =============================================================================


# -----------------------------------------------------------------------------
#  REQUIRED
# -----------------------------------------------------------------------------

# Your Google Cloud project ID.
# If left empty, the scripts fall back to `gcloud config get-value project`
# and abort with an error if that is also unset. There is deliberately no
# hardcoded project default.
GCP_PROJECT=

# Region for Cloud Run, Artifact Registry and the workspace bucket.
# Cloud Run instances and sandboxes are a Tech Preview and are not available
# in every region; us-east4 is known to work. If instance creation fails with
# "Capacity exhausted", try a different region before debugging anything else.
GCP_REGION=us-east4


# -----------------------------------------------------------------------------
#  DEPLOYMENT TARGETS  (optional — sensible defaults shown)
# -----------------------------------------------------------------------------

# Name of the singleton Cloud Run instance.
INSTANCE_NAME=antigravity-console-instance

# Instance footprint. These defaults are the smallest size that comfortably
# runs this example; they are set explicitly because the gcloud default is
# 2 GiB, which would not match the documented configuration. Size up for real
# workloads after watching CPU and memory over a few representative runs.
INSTANCE_CPU=2
INSTANCE_MEMORY=4Gi

# Artifact Registry repository that holds the container images.
REPO_NAME=antigravity-runners

# Cloud Storage bucket mounted at /workspace as the persistent output plane.
# Leave empty to use "${GCP_PROJECT}-antigravity-artifacts".
# Keep the bucket in the same region as the instance so storage and compute
# are co-located.
BUCKET_NAME=

# Service account the instance runs as. It needs roles/aiplatform.user (to
# call Vertex AI) and roles/storage.objectAdmin on the bucket above.
# Leave empty to use "antigravity-swarm-sa@${GCP_PROJECT}.iam.gserviceaccount.com".
#
# NOTE: grant the bucket IAM binding BEFORE switching an existing instance to a
# new service account. If the identity cannot read the bucket, the gcsfuse
# mount fails, the container exits, and Cloud Run serves a 404 that looks like
# a routing problem rather than a permissions one.
SERVICE_ACCOUNT=

# Set to "true" to reuse the existing :latest image instead of rebuilding.
# The default is to always rebuild, because a deploy that silently ships a
# stale image reports success while changing nothing.
SKIP_BUILD=false


# -----------------------------------------------------------------------------
#  AUTHENTICATION
# -----------------------------------------------------------------------------

# NextAuth session signing secret, minimum 32 characters.
# Leave empty and the scripts generate a fresh one per deployment.
#
# Generate explicitly with:  openssl rand -hex 32
#
# Never commit a real value. A committed signing key is a public key: anyone
# could forge a valid admin session against your deployment without ever
# needing the password.
NEXTAUTH_SECRET=

# Credentials for the built-in username/password login.
#
# Leave ADMIN_PASSWORD empty and the scripts generate a fresh one per
# deployment and print it once in the summary at the end of the run. Set it
# here to pin a value of your own.
#
# Generate explicitly with:  openssl rand -hex 12
#
# Never commit a real value, and do not restore a default. The console is
# served on a public endpoint, so a password published in the repository is
# not a credential, it is a documented way in. The application enforces this:
# with ADMIN_PASSWORD unset in production it disables password sign-in
# entirely rather than falling back to anything, leaving Google OAuth as the
# only route in.
#
# Redeploy behaviour differs between the two deployment paths:
#   * deploy-instance.sh only rewrites the credentials when ADMIN_PASSWORD is
#     set explicitly. A plain redeploy leaves the running instance on the
#     credentials it was created with, so logins keep working.
#   * deploy.sh (Terraform) applies whatever is configured on every run.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional Google OAuth provider. Leave both empty to use only the built-in
# admin credentials login. See docs/OAUTH_SETUP.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# -----------------------------------------------------------------------------
#  LOCAL DEVELOPMENT  (run-local.sh only)
# -----------------------------------------------------------------------------

# Host port the local container binds to.
PORT=3000

# Hostname used to build the printed URL. Change this if you run the container
# on a remote workstation and reach it by hostname rather than localhost.
HOST_FQDN=localhost

# Local Docker image tag built by run-local.sh.
IMAGE_NAME=agy-console-local

# Name of the local container. run-local.sh stops and removes any container
# with this name before starting a new one, so two checkouts running in
# parallel need two different names.
CONTAINER_NAME=agy-console-dev


# -----------------------------------------------------------------------------
#  SWARM RUNTIME
# -----------------------------------------------------------------------------

# Model the swarm runs on, resolved through Vertex AI.
# Only the Gemini 2.5 family is served by Vertex AI today; the 3.x aliases the
# Antigravity harness knows about are backend-only names and return 404 when
# the SDK is configured with vertex=True.
ANTIGRAVITY_MODEL=gemini-2.5-flash

# Directory the swarm writes generated application code into. Everything the
# agents produce must live under this path.
TARGET_APP_DIR=/workspace/target-app

# Set to 0 to disable the hook that blocks writes outside TARGET_APP_DIR.
# Leave at 1 unless you are debugging the guardrail itself.
SWARM_ENFORCE_SCOPE=1
